# YATRA Backend Configuration
# Copy this to .env and fill in your values

# Server Configuration
PORT=8000
ENVIRONMENT=development

# Mapbox Integration (Optional)
# Get free token from https://mapbox.com
MAPBOX_ACCESS_TOKEN=

# Future: API Keys for Real Providers
# IRCTC_API_KEY=
# SKYSCANNER_API_KEY=
# AMADEUS_API_KEY=
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/yatra

# Logging
LOG_LEVEL=info
